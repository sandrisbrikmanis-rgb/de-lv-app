# Kopējiet uz android/keystore.properties un aizpildiet ar saviem datiem.
# Failu android/keystore.properties NEcommitojiet repozitorijā.
#
# storeFile — ceļš uz .jks vai .keystore failu (relatīvs no android/ mapi).
# Piemērs: ../release.keystore  vai  C:/Users/sandr/keys/vacuvaloda-release.jks

storeFile=../release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
