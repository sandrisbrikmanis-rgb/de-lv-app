    "überreden": {
      "id": "b1-überreden",
      "translation": "veenma",
      "explanation": "Põhiidee: überreden tähendab kedagi kõnetada või meelitada, et ta midagi teeks. See rõhutab tegevust, mitte ainult mõtlemist. überzeugen tähendab kedagi argumentidega veenda.",
      "examples": [
        { "de": "Er hat mich überredet, mitzukommen.", "lv": "ta kõnetas mind kaasa tulema." },
        { "de": "Sie überredete ihn, früher zu gehen.", "lv": "ta kõnetas teda varem minema." },
        { "de": "Sie überzeugte ihn mit guten Argumenten.", "lv": "ta veenis teda heade argumentidega." }
      ],
      "comparison": [
        { "word": "überreden", "meaning": "kõnetama / veenma tegutsema", "example": "Er hat mich überredet, mitzukommen. = Ta kõnetas mind kaasa tulema." },
