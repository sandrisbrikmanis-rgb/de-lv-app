  "Eben das meine ich.": {
    "lv": "Tieši to es domāju."
  },
  "Ich warte den Regen ab.": {
    "lv": "Es nogaidīšu, kamēr lietus pārtiks."
  },
  "Ich habe eine Bitte an Sie.": {
    "lv": "Man ir lūgums jums."
  },
  "Ich möchte den Vertrag ändern.": {
    "lv": "Es vēlos mainīt līgumu."
  },
  "Er saß unter den Zuschauern.": {
    "lv": "Viņš sēdēja starp skatītājiem."
  },
  "Die Zeit drängt.": {
    "lv": "Laiks steidz."
  }
}
