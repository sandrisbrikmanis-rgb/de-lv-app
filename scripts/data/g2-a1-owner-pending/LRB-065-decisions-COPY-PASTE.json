    "neu|idx:439": {
      "lv": "nei (fir Saachen)",
      "study.translation": "nei (fir Saachen)",
      "study.explanation": [
        "Haaptiddi: neu bedeit nei am Sënn vun enger Saach – viru Kuerzem hiergestallt, kaf oder fir d’éischt benotzt.",
        "neu beschreift Saachen, Apparater, Kleeder, Haiser, Iddien asw. – net den Alter vun enger Persoun oder engem Déier.",
        "Op Lëtzebuergesch ënnerscheet een tëscht jonk fir den Alter (jung) an nei fir eppes, wat viru Kuerzem entstanen ass (neu).",
        "Fir den Alter vun enger Persoun oder engem Déier benotzt een jung, net neu.",
        "neu gëtt och am iwwerdroene Sënn benotzt: eng nei Aarbecht, nei Informatiounen, en neien Ufank.",
        "De Géigendeel ass alt; d’Substantiv das Neue bedeit eppes Neies."
      ],
      "study.examples": [
        {
          "de": "Mein Handy ist neu.",
          "lv": "Mäin Handy ass nei."
        },
        {
          "de": "Wir haben ein neues Auto.",
          "lv": "Mir hunn en neien Auto."
        },
        {
          "de": "Das ist meine neue Wohnung.",
          "lv": "Dat ass meng nei Wunneng."
        },
        {
          "de": "Ich habe neue Schuhe gekauft.",
          "lv": "Ech hunn nei Schong kaf."
        },
        {
          "de": "Das ist eine neue Idee.",
          "lv": "Dat ass eng nei Iddi."
        },
        {
          "de": "Er hat einen neuen Job.",
          "lv": "Hien huet eng nei Aarbecht."
        },
        {
          "de": "Was gibt es Neues?",
          "lv": "Wat gëtt et Neies?"
        }
      ],
      "study.tip": [
        "neu bezitt sech op Saachen, Apparater an Neiegkeeten – fir den Alter vun enger Persoun benotzt een jung.",
        "Géigendeel: neu ↔ alt (nei ↔ al)."
      ],
      "study.important": [
        "neu beschreift Saachen an Neiegkeeten, net den Alter vun enger Persoun oder engem Déier.",
        "Fir den Alter vun enger Persoun oder engem Déier benotzt een jung, net neu.",
        "Falsch: Meine Schwester ist neu. → Richteg: Meine Schwester ist jung."
      ],
