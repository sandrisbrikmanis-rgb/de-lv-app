    "Reis|idx:496": {
      "lv": "Räis",
      "study.translation": "Räis",
      "study.explanation": "Am Däitsche gëtt „der Reis“ nëmmen am Eenzuel benotzt, dofir muss d’Verb am Eenzuel stoen (zum Beispill „ist“, net „sind“). Och op Lëtzebuergesch gëtt normalerweis „de Räis“ am Eenzuel benotzt.",
      "study.examples": [
        {
          "de": "Der Reis ist fertig.",
          "lv": "De Räis ass fäerdeg."
        },
        {
          "de": "Ich esse Reis.",
          "lv": "Ech iesse Räis."
        },
        {
          "de": "Kochst du Reis?",
          "lv": "Kachs du Räis?"
        },
        {
          "de": "Der Reis schmeckt gut.",
          "lv": "De Räis schmaacht gutt."
        }
      ],
      "study.tip": {
        "text": "Denk drun: der Reis steet am Däitschen am Eenzuel; op Lëtzebuergesch seet een och normalerweis de Räis."
      },
      "study.important": [
        "der Reis — am Däitschen nëmmen Eenzuel (Der Reis ist ..., net *sind).",
        "Op Lëtzebuergesch gëtt de Räis normalerweis och am Eenzuel benotzt."
      ],
