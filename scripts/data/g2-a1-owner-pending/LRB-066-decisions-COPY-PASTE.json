    "schwimmen|idx:531": {
      "lv": "schwammen",
      "study.translation": "schwammen",
      "study.explanation": [
        "Haaptiddi: schwimmen bedeit, sech mat Schwammbeweegungen am Waasser fortzebeweegen oder Schwammen als Sport ze maachen.",
        "schwimmen gëtt benotzt, wann eng Persoun mat Schwammbeweegungen duerch d’Waasser schwëmmt.",
        "Wann et ëm Erhuelung am Waasser oder ëm Bueden geet, gëtt dacks baden benotzt.",
        "Um Niveau A1 ass den Ënnerscheed wichteg: schwimmen = schwammen, baden = bueden."
      ],
      "study.examples": [
        {
          "de": "Ich schwimme gern.",
          "lv": "Ech schwamme gär."
        },
        {
          "de": "Er schwimmt sehr gut.",
          "lv": "Hie schwëmmt ganz gutt."
        },
        {
          "de": "Wir schwimmen im Schwimmbad.",
          "lv": "Mir schwammen an der Schwämm."
        },
        {
          "de": "Ich gehe baden.",
          "lv": "Ech gi bueden."
        }
      ],
      "study.comparison": [
        {
          "word": "schwimmen",
          "meaning": "schwammen als Beweegung oder Sport",
          "example": "Er schwimmt sehr gut."
        },
        {
          "word": "baden",
          "meaning": "bueden / sech am Waasser ophalen",
          "example": "Ich gehe baden."
        },
        {
          "word": "schwimmen gehen",
          "meaning": "schwamme goen",
          "example": "Wir gehen schwimmen."
        },
        {
          "word": "duschen",
          "meaning": "sech duschen",
          "example": "Ich dusche morgens."
        }
      ],
      "study.tip": {
        "text": "Denk drun: Schwammbeweegung → schwimmen; Erhuelung am Waasser → baden."
      },
      "study.important": [
        "schwimmen a baden sinn net datselwecht.",
        "Op Lëtzebuergesch gëtt et den Ënnerscheed tëscht schwammen a bueden; am Däitsche muss ee genee op de Kontext oppassen."
