{
  "schemaVersion": "g2-a1-card-translation-bilingual-audit-lv-lt-pl-v1",
  "description": "Kartīšu tulkojuma audits — primārie divvalodu avoti lv/lt/pl, papildavoti un meklēšanas secība (DE→TARGET, tad TARGET→DE, papildavoti tikai ja primārais neko nedod).",
  "auditSequence": [
    {
      "step": 1,
      "rule": "Meklē tiešo pāri DE→TARGET primārajā digitālajā vārdnīcā."
    },
    {
      "step": 2,
      "rule": "Ja nav, meklē TARGET→DE primārajā pretējā virziena vārdnīcā."
    },
    {
      "step": 3,
      "rule": "Vēsturiskos / skenuotos papildavotus izmanto tikai tad, ja abi primārie virzieni nedod derīgu pāri."
    },
    {
      "step": 4,
      "rule": "Pārbaudi vārdšķiru un konkrētās kartītes vācu nozīmi; citai nozīmei piederošu ekvivalentu nepieņem."
    },
    {
      "step": 5,
      "rule": "Automātiskos tulkotājus (Glosbe Translate u.c.) neizmanto kā pierādījumu."
    },
    {
      "step": 6,
      "rule": "Saglabā avota nosaukumu, virzienu, atrasto pāri un precīzo šķirkļa vai lapas URL."
    }
  ],
  "regressionPilotDeLemmas": ["Haus", "arbeiten", "Kleingeld", "bewirten", "Grenzkonflikt", "Machtgier"],
