  "auditSequence": [
    {
      "step": 1,
      "rule": "Meklē tiešo pāri DE→TARGET UDEW (Leipzig) bidirectionālajā tiešsaistes vārdnīcā."
    },
    {
      "step": 2,
      "rule": "Ja nav, meklē TARGET→DE tajā pašā UDEW (ukrainisch_deutsch_online.htm?input=…)."
    },
    {
      "step": 3,
      "rule": "Ja UDEW nepieejams, izmanto dict.cc DE→UK / UK→DE (MASTER rezerve)."
    },
    {
      "step": 4,
      "rule": "Pārbaudi vārdšķiru un konkrētās kartītes vācu nozīmi; citai nozīmei piederošu ekvivalentu nepieņem."
    },
    {
      "step": 5,
      "rule": "Automātiskos tulkojumus un botu sienas lapas neizmanto kā pierādījumu."
    },
    {
      "step": 6,
      "rule": "Saglabā avota nosaukumu, virzienu, variantus un precīzo meklējuma URL."
    }
  ],
