        "study": {
          "id": "a1-frau",
          "layout": "standardStudy",
          "translation": "Fra",
          "explanation": [
            "Haaptiddi: die Frau kann allgemeng eng weiblech Persoun oder am Bestietnes d’Fra vun engem bedeiten.",
            "Wann et allgemeng ëm eng weiblech Persoun geet, bedeit die Frau „Fra“.",
            "Wann et ëm d’Persoun geet, mat där ee bestuet ass, bedeit die Frau och „Fra“: meine Frau = meng Fra.",
            "Mat engem Possessivartikel wéi meine, deine oder seine ass bal ëmmer d’Fra gemengt, mat där d’Persoun bestuet ass.",
            "De Pluriel ass die Frauen.",
            "Beim däitsche Wuert der Mann gëtt et déi selwecht Duebelbedeitung: Mann a Bestietnespartner."
          ],
          "examples": [
            {
              "de": "Sie ist eine nette Frau.",
              "lv": "Si ass eng léif Fra."
            },
            {
              "de": "Das ist meine Frau.",
              "lv": "Dat ass meng Fra."
            },
            {
              "de": "Wie viele Frauen sind hier?",
              "lv": "Wéi vill Frae sinn hei?"
            },
            {
              "de": "Meine Frau arbeitet in Berlin.",
              "lv": "Meng Fra schafft zu Berlin."
            },
            {
              "de": "Die Frau trägt ein Kleid.",
              "lv": "D’Fra huet e Kleed un."
            },
            {
              "de": "Seine Frau ist Ärztin.",
              "lv": "Seng Fra ass Doktesch."
            }
          ],
          "tip": [
            "Mat engem Possessivartikel wéi meine, deine oder seine ass bal ëmmer d’Fra gemengt, mat där d’Persoun bestuet ass.",
            "Ouni Possessivartikel bedeit die Frau oder eine Frau normalerweis eng weiblech Persoun."
          ],
          "important": [
            "die Frau = Fra als weiblech Persoun ODER als Fra, mat där ee bestuet ass; de Kontext entscheet.",
            "meine Frau = meng Fra.",
            "De Pluriel ass die Frauen."
          ],
