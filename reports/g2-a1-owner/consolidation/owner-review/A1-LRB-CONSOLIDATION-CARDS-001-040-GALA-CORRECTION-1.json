    {
      "target_language": "bg",
      "canonical_card_object_id": "aufs",
      "full_card_owner_new": {
        "lv": "към / върху (накъде?)",
        "study": {
          "id": "a1-aufs",
          "layout": "standardStudy",
          "translation": "към / върху (накъде?)",
          "explanation": [
            "aufs е съкращение от предлога auf и члена das.",
            "Пълната форма е auf das.",
            "Употребява се с неутрално съществително в единствено число при движение към място или повърхност и отговаря на Wohin? (накъде?).",
            "Среща се често при качване, сядане, поставяне или пътуване към нещо.",
            "В разговорната реч aufs е обичайно, но пълната форма auf das също е граматически правилна."
          ],
          "examples": [
            {
              "de": "Ich gehe aufs Dach.",
              "lv": "Отивам на покрива"
            },
            {
              "de": "Sie setzt sich aufs Sofa.",
              "lv": "Тя сяда на дивана."
            },
            {
              "de": "Wir fahren aufs Land.",
              "lv": "Отиваме на село."
            },
            {
              "de": "Stell die Tasche aufs Bett.",
              "lv": "Сложи чантата си на леглото."
            },
            {
              "de": "Er springt aufs Pferd.",
              "lv": "Качва се на коня."
            },
            {
              "de": "Leg das Buch aufs Regal.",
              "lv": "Поставете книгата на рафта."
            },
            {
              "de": "Komm schnell aufs Boot!",
              "lv": "Качи се бързо на лодката!"
            },
            {
              "de": "Wir gehen aufs Fest.",
              "lv": "Отиваме на купон."
            }
          ],
          "comparison": [
            {
              "word": "aufs",
              "meaning": "накъде? (Akkusativ, neuter sg.)",
              "example": "aufs Dach – на покрива"
            },
            {
              "word": "auf",
              "meaning": "На повърхността или нагоре",
              "example": "auf den Tisch – на масата"
            },
            {
              "word": "an",
              "meaning": "на вертикална повърхност",
              "example": "an die Wand – на стената"
            },
            {
              "word": "ins",
              "meaning": "Вътрешности",
              "example": "ins Zimmer – в стаята"
            },
            {
              "word": "zum",
              "meaning": "На/на (на кого?)",
              "example": "zum Arzt – при лекаря"
            }
          ],
          "tip": [
            "Запомнете: auf + das → aufs (Wohin? = накъде?).",
            "Пълният auf das почти никога не се произнася — използва се aufs."
          ],
          "important": [
            "aufs = auf das и се използва с неутрално съществително в единствено число.",
            "Формата обозначава движение към място или повърхност.",
            "Изборът между aufs, an, ins и zum зависи от вида на мястото и посоката."
          ],
