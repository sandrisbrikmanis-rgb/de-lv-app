    {
      "id": "ET-SENT-0162",
      "cardId": "sentence-774",
      "deContext": "Wann sind die Fotos fertig?",
      "currentEt": "Millal fotod on valmis?",
      "status": "LABOT",
      "ownerNew": "Millal fotod valmis saavad?",
      "note": "Loomulik sõnajärg."
    },
    {
      "id": "ET-SENT-0163",
      "cardId": "sentence-784",
      "deContext": "Zeigen Sie mir schöne Geschenkideen.",
