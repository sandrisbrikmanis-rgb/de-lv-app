    },
    {
      "id": "ET-SENT-0155",
      "cardId": "sentence-753",
      "deContext": "Wann wird er fertig sein?",
      "currentEt": "Millal on valmis?",
      "status": "LABOT",
      "ownerNew": "Millal ta valmis saab?",
      "note": "Säilita asesõna „er”."
