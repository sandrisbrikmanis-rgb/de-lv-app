    {
      "id": "ET-SENT-0142",
      "cardId": "sentence-714",
      "deContext": "Das Buch ist leider ausverkauft.",
      "currentEt": "Kahjuks on raamat läbi müüdud.",
      "status": "LABOT",
      "ownerNew": "Kahjuks on raamat välja müüdud.",
      "note": "„Välja müüdud” on loomulik vaste."
    },
    {
      "id": "ET-SENT-0143",
      "cardId": "sentence-723",
      "deContext": "Wiegen Sie mir bitte zwei Kilo ab.",
      "currentEt": "Kaaluge palun kaks kilogrammi.",
      "status": "LABOT",
      "ownerNew": "Kaaluge mulle palun kaks kilogrammi.",
      "note": "Lisa „mulle”."
    },
    {
      "id": "ET-SENT-0144",
      "cardId": "sentence-726",
      "deContext": "Geben Sie mir zwei Kilo Hackfleisch.",
      "currentEt": "Andke kaks kilogrammi hakkliha.",
      "status": "LABOT",
      "ownerNew": "Andke mulle kaks kilogrammi hakkliha.",
      "note": "Lisa „mulle”."
    },
    {
      "id": "ET-SENT-0145",
      "cardId": "sentence-727",
      "deContext": "Ein Laib Brot, bitte, aber nicht zu knusprig.",
      "currentEt": "Üks leivapäts, palun, aga mitte liiga kõva.",
      "status": "FALSE_POSITIVE",
      "ownerNew": "",
      "note": "„mitte liiga kõva” sisaldab negatsiooni."
    },
    {
      "id": "ET-SENT-0146",
      "cardId": "sentence-727",
      "deContext": "Ein Laib Brot, bitte, aber nicht zu knusprig.",
      "currentEt": "Üks leivapäts, palun, aga mitte liiga kõva.",
      "status": "LABOT",
      "ownerNew": "Üks leivapäts, palun, aga mitte liiga krõbe.",
