      "status": "FALSE_POSITIVE",
      "ownerNew": "",
      "note": "„Minu käekell ei tööta” sisaldab negatsiooni."
    },
    {
      "id": "ET-SENT-0159",
      "cardId": "sentence-769",
      "deContext": "Bitte packen Sie es ein und schicken Sie es mir nach Hause.",
      "currentEt": "Palun pakkige ja saatke koju.",
      "status": "LABOT",
      "ownerNew": "Palun pakkige see sisse ja saatke see mulle koju.",
      "note": "Lisa objektid ja „mulle”."
    },
    {
      "id": "ET-SENT-0160",
      "cardId": "sentence-772",
      "deContext": "Setzen Sie sich, schauen Sie gerade in die Kamera und bewegen Sie sich nicht!",
      "currentEt": "Istuge, vaadake otse kaamerasse ja ärge liikuge!",
      "status": "FALSE_POSITIVE",
      "ownerNew": "",
      "note": "„ärge liikuge” sisaldab negatsiooni."
