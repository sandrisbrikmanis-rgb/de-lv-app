    {
      "id": "ET-SENT-0164",
      "cardId": "sentence-788",
      "deContext": "Das ist kein echter Stein, das ist Glas.",
      "currentEt": "See ei ole ehtne kivi, see on klaas.",
      "status": "FALSE_POSITIVE",
      "ownerNew": "",
      "note": "„See ei ole ehtne kivi” sisaldab negatsiooni."
    },
    {
      "id": "ET-SENT-0165",
      "cardId": "sentence-791",
      "deContext": "Der Preis ist nicht hoch.",
      "currentEt": "Hind ei ole kõrge.",
      "status": "FALSE_POSITIVE",
      "ownerNew": "",
      "note": "„Hind ei ole kõrge” sisaldab negatsiooni."
    },
    {
      "id": "ET-SENT-0166",
      "cardId": "sentence-794",
      "deContext": "Falls es meiner Frau nicht gefällt, kann ich es umtauschen?",
      "currentEt": "Kui mu naisele ei meeldi, kas ma saan vahetada?",
      "status": "FALSE_POSITIVE",
      "ownerNew": "",
      "note": "„Kui mu naisele ei meeldi” sisaldab negatsiooni."
    }
