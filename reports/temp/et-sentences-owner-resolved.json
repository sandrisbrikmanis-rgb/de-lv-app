      "ownerNew": "Kas te saate mööbli minu korterisse toimetada?",
      "note": "Säilita „meine Wohnung”."
    },
    {
      "id": "ET-SENT-0150",
      "cardId": "sentence-743",
      "deContext": "Schneiden Sie mir bitte drei Meter ab.",
      "currentEt": "Lõigake palun kolm meetrit.",
      "status": "LABOT",
      "ownerNew": "Lõigake mulle palun kolm meetrit.",
      "note": "Lisa „mulle”."
    },
    {
      "id": "ET-SENT-0151",
      "cardId": "sentence-744",
      "deContext": "Haben Sie auch andere Muster?",
