    {
      "id": "ET-SENT-0152",
      "cardId": "sentence-745",
      "deContext": "Diese Farbe gefällt mir nicht.",
      "currentEt": "Mulle ei meeldi see värv.",
      "status": "FALSE_POSITIVE",
      "ownerNew": "",
      "note": "„Mulle ei meeldi” sisaldab negatsiooni."
    },
    {
      "id": "ET-SENT-0153",
      "cardId": "sentence-746",
      "deContext": "Geben Sie mir eine hellere.",
      "currentEt": "Andke heledam.",
      "status": "LABOT",
      "ownerNew": "Andke mulle heledam.",
      "note": "Lisa „mulle”."
    },
    {
      "id": "ET-SENT-0154",
      "cardId": "sentence-750",
      "deContext": "So, nun passen sie gut.",
      "currentEt": "Nii, nüüd sobib hästi.",
      "status": "LABOT",
      "ownerNew": "Nii, nüüd sobivad need hästi.",
