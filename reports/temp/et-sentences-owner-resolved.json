      "id": "ET-SENT-0133",
      "cardId": "sentence-673",
      "deContext": "Hast du alles eingepackt?",
      "currentEt": "Kas kõik on juba kastidesse pandud?",
      "status": "LABOT",
      "ownerNew": "Kas oled kõik juba sisse pakkinud?",
      "note": "Aktiivne subjekt „oled”."
    },
    {
      "id": "ET-SENT-0134",
      "cardId": "sentence-674",
      "deContext": "Ich stehe mit meinem Freund in Kontakt.",
      "currentEt": "Olen kirjavahetuses oma sõbraga.",
      "status": "LABOT",
      "ownerNew": "Olen oma sõbraga kontaktis.",
      "note": "„In Kontakt” = kontaktis, mitte ainult kirjavahetuses."
    },
    {
      "id": "ET-SENT-0135",
      "cardId": "sentence-682",
      "deContext": "Schwimm nicht zu weit hinaus!",
      "currentEt": "Ära uju liiga kaugele!",
      "status": "FALSE_POSITIVE",
      "ownerNew": "",
      "note": "„Ära uju liiga kaugele” sisaldab negatsiooni."
    },
    {
      "id": "ET-SENT-0136",
      "cardId": "sentence-686",
      "deContext": "Er hat sich aber recht verändert.",
      "currentEt": "Ta on ikkagi üsna muutunud.",
      "status": "LABOT",
      "ownerNew": "Ta on aga üsna palju muutunud.",
