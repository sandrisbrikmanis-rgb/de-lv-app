    {
      "id": "ET-SENT-0156",
      "cardId": "sentence-757",
      "deContext": "Wann wird das Kleid fertig sein?",
      "currentEt": "Millal kleit on valmis?",
      "status": "LABOT",
      "ownerNew": "Millal kleit valmis saab?",
      "note": "Loomulik sõnajärg ja „valmis saab”."
    },
    {
      "id": "ET-SENT-0157",
      "cardId": "sentence-760",
      "deContext": "Wann kann ich die Schuhe abholen?",
