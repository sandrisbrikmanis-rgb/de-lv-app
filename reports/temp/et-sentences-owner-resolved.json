    },
    {
      "id": "ET-SENT-0137",
      "cardId": "sentence-689",
      "deContext": "Ich fühle mich nicht wohl.",
      "currentEt": "Tunnen end halvasti.",
      "status": "FALSE_POSITIVE",
      "ownerNew": "",
      "note": "„Tunnen end halvasti” vastab „fühl mich nicht wohl”."
    },
    {
      "id": "ET-SENT-0138",
      "cardId": "sentence-695",
      "deContext": "Leg dich ins Bett!",
      "currentEt": "Heida voodisse pikali!",
      "status": "LABOT",
      "ownerNew": "Heida voodisse!",
      "note": "Eemalda tarbetud „pikali”."
    },
    {
      "id": "ET-SENT-0139",
      "cardId": "sentence-698",
      "deContext": "Ich habe Zahnschmerzen.",
      "currentEt": "Mul valutab hammas.",
      "status": "LABOT",
      "ownerNew": "Mul valutavad hambad.",
      "note": "Saksa mitmus „Zahnschmerzen”."
    },
    {
      "id": "ET-SENT-0140",
      "cardId": "sentence-702",
      "deContext": "Ich will meine Wohnung neu möblieren.",
      "currentEt": "Tahan korterit uuesti sisustada.",
      "status": "LABOT",
      "ownerNew": "Tahan oma korterit uuesti sisustada.",
      "note": "Säilita „meine Wohnung”."
    },
    {
      "id": "ET-SENT-0141",
      "cardId": "sentence-711",
      "deContext": "Ich nehme seit einem Jahr Deutschstunden.",
