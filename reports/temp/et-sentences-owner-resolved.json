    {
      "id": "ET-SENT-0147",
      "cardId": "sentence-735",
      "deContext": "Geben Sie mir bitte ein Kilo Reis.",
      "currentEt": "Andke palun kilogramm riisi.",
      "status": "LABOT",
      "ownerNew": "Andke mulle palun kilogramm riisi.",
      "note": "Lisa „mulle”."
    },
    {
      "id": "ET-SENT-0148",
      "cardId": "sentence-736",
      "deContext": "Danke, diesmal nicht.",
      "currentEt": "Aitäh, seekord mitte.",
      "status": "FALSE_POSITIVE",
      "ownerNew": "",
