  "sentences": [
    {
      "cardId": "sentence-400",
      "index": 400,
      "batch": "batch-401-450",
      "de": "Bis wann?",
      "daCurrent": "Kuni millise ajani?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-401",
      "index": 401,
      "batch": "batch-401-450",
      "de": "Es ist warm.",
      "daCurrent": "On soe.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-402",
      "index": 402,
      "batch": "batch-401-450",
      "de": "Auf eine Nachricht warten.",
      "daCurrent": "Oodata teadet.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-403",
      "index": 403,
      "batch": "batch-401-450",
      "de": "Was wollen Sie?",
      "daCurrent": "Mida te soovite?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-404",
      "index": 404,
      "batch": "batch-401-450",
      "de": "Was für ein...?",
      "daCurrent": "Milline...? • Mis...?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-405",
      "index": 405,
      "batch": "batch-401-450",
      "de": "Auf halbem Wege.",
      "daCurrent": "Poolel teel.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-406",
      "index": 406,
      "batch": "batch-401-450",
      "de": "Auf diesem Wege.",
      "daCurrent": "Sel viisil. • Selliste vahenditega.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-407",
      "index": 407,
      "batch": "batch-401-450",
      "de": "Auf friedlichem Wege.",
      "daCurrent": "Rahumeelsel teel.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-408",
      "index": 408,
      "batch": "batch-401-450",
      "de": "Unserer Freundschaft wegen.",
      "daCurrent": "Meie sõpruse pärast.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-409",
      "index": 409,
      "batch": "batch-401-450",
      "de": "Von Rechts wegen.",
      "daCurrent": "Õigluse järgi.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-410",
      "index": 410,
      "batch": "batch-401-450",
      "de": "Weh tun.",
      "daCurrent": "Valutada.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-411",
      "index": 411,
      "batch": "batch-401-450",
      "de": "Zu Weihnachten.",
      "daCurrent": "Jõulude ajal.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-412",
      "index": 412,
      "batch": "batch-401-450",
      "de": "Auf welche Weise?",
      "daCurrent": "Mil viisil?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-413",
      "index": 413,
      "batch": "batch-401-450",
      "de": "Art und Weise.",
      "daCurrent": "Viis.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-414",
      "index": 414,
      "batch": "batch-401-450",
      "de": "Ohne weiteres.",
      "daCurrent": "Kohe. • Viivitamatult.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-415",
      "index": 415,
      "batch": "batch-401-450",
      "de": "Bis auf weiteres.",
      "daCurrent": "Kuni edasise korralduseni.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-416",
      "index": 416,
      "batch": "batch-401-450",
      "de": "Und so weiter.",
      "daCurrent": "Ja nii edasi.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-417",
      "index": 417,
      "batch": "batch-401-450",
      "de": "Weiter nichts.",
      "daCurrent": "Muud midagi.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-418",
      "index": 418,
      "batch": "batch-401-450",
      "de": "An welchem Tag?",
      "daCurrent": "Millisel päeval?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-419",
      "index": 419,
      "batch": "batch-401-450",
      "de": "Alle Welt.",
      "daCurrent": "Kogu maailm. • Kõik.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-420",
      "index": 420,
      "batch": "batch-401-450",
      "de": "In wenigen Tagen.",
      "daCurrent": "Mõne päeva pärast.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-421",
      "index": 421,
      "batch": "batch-401-450",
      "de": "Zu wenig.",
      "daCurrent": "Liiga vähe.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-422",
      "index": 422,
      "batch": "batch-401-450",
      "de": "Wenn auch.",
      "daCurrent": "Kuigi.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-423",
      "index": 423,
      "batch": "batch-401-450",
      "de": "Wer da?",
      "daCurrent": "Kes seal on?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-424",
      "index": 424,
      "batch": "batch-401-450",
      "de": "Gesammelte Werke von Schiller.",
      "daCurrent": "Schilleri kogutud teosed.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-425",
      "index": 425,
      "batch": "batch-401-450",
      "de": "Ausgewählte Werke.",
      "daCurrent": "Valik teoseid.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-426",
      "index": 426,
      "batch": "batch-401-450",
      "de": "Er ist wert, dass...",
      "daCurrent": "Ta on ära teeninud, et...",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-427",
      "index": 427,
      "batch": "batch-401-450",
      "de": "Es ist zwei Euro wert.",
      "daCurrent": "See maksab kaks eurot.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-428",
      "index": 428,
      "batch": "batch-401-450",
      "de": "Nach Westen.",
      "daCurrent": "Läände.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-429",
      "index": 429,
      "batch": "batch-401-450",
      "de": "Von Westen.",
      "daCurrent": "Läänest.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-430",
      "index": 430,
      "batch": "batch-401-450",
      "de": "In Wettbewerb treten.",
      "daCurrent": "Astuda võistlusse.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-431",
      "index": 431,
      "batch": "batch-401-450",
      "de": "Um die Wette laufen.",
      "daCurrent": "Võistelda jooksus.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-432",
      "index": 432,
      "batch": "batch-401-450",
      "de": "Was gilt die Wette?",
      "daCurrent": "Mille peale me kihla veame?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-433",
      "index": 433,
      "batch": "batch-401-450",
      "de": "Wie wird das Wetter?",
      "daCurrent": "Milline ilm tuleb?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-434",
      "index": 434,
      "batch": "batch-401-450",
      "de": "Wettkampf im Turnen.",
      "daCurrent": "Võistlused võimlemises.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-435",
      "index": 435,
      "batch": "batch-401-450",
      "de": "Wider meinen Willen.",
      "daCurrent": "Vastu minu tahtmist.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-436",
      "index": 436,
      "batch": "batch-401-450",
      "de": "Widerspruch erheben.",
      "daCurrent": "Protesteerida. • Esitada vastuväiteid.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-437",
      "index": 437,
      "batch": "batch-401-450",
      "de": "Wie alt ist er?",
      "daCurrent": "Kui vana ta on?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-438",
      "index": 438,
      "batch": "batch-401-450",
      "de": "Wie lange?",
      "daCurrent": "Kui kaua?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-439",
      "index": 439,
      "batch": "batch-401-450",
      "de": "Auf Wiederhören!",
      "daCurrent": "Kuulmiseni!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-440",
      "index": 440,
      "batch": "batch-401-450",
      "de": "Auf Wiedersehen!",
      "daCurrent": "Nägemiseni!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-441",
      "index": 441,
      "batch": "batch-401-450",
      "de": "Wilde Tiere.",
      "daCurrent": "Metsloomad.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-442",
      "index": 442,
      "batch": "batch-401-450",
      "de": "Herzlich willkommen!",
      "daCurrent": "Südamlikult teretulnud!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-443",
      "index": 443,
      "batch": "batch-401-450",
      "de": "Du musst ziehen.",
      "daCurrent": "Sinu kord käia.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-444",
      "index": 444,
      "batch": "batch-401-450",
      "de": "Es zieht.",
      "daCurrent": "Tõmbab tuult.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-445",
      "index": 445,
      "batch": "batch-401-450",
      "de": "Ziemlich kalt.",
      "daCurrent": "Üsna külm.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-446",
      "index": 446,
      "batch": "batch-401-450",
      "de": "Zipfel einer Wurst.",
      "daCurrent": "Vorsti otsatükk.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-447",
      "index": 447,
      "batch": "batch-401-450",
      "de": "Zu ihm gehen.",
      "daCurrent": "Minna tema juurde.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-448",
      "index": 448,
      "batch": "batch-401-450",
      "de": "Zur Schule gehen.",
      "daCurrent": "Kooli minna.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-449",
      "index": 449,
      "batch": "batch-401-450",
      "de": "Zu Hause bleiben.",
      "daCurrent": "Koju jääda.",
      "level": "Sätze"
    }
  ]
