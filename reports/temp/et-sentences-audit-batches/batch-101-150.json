      "level": "Sätze"
    },
    {
      "cardId": "sentence-109",
      "index": 109,
      "batch": "batch-101-150",
      "de": "Guten Appetit!",
      "daCurrent": "Head isu!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-110",
      "index": 110,
      "batch": "batch-101-150",
      "de": "In einem Atemzug.",
      "daCurrent": "Ühe hingetõmbega.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-111",
      "index": 111,
      "batch": "batch-101-150",
      "de": "Auf jeden Fall.",
      "daCurrent": "Igal juhul.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-112",
      "index": 112,
      "batch": "batch-101-150",
      "de": "Auf einmal war alles still.",
      "daCurrent": "Järsku jäi kõik vaikseks.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-113",
      "index": 113,
      "batch": "batch-101-150",
      "de": "Bitte mach die Tür auf!",
      "daCurrent": "Ava palun uks!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-114",
      "index": 114,
      "batch": "batch-101-150",
      "de": "Er hat den Kredit aufgenommen.",
      "daCurrent": "Ta võttis laenu.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-115",
      "index": 115,
      "batch": "batch-101-150",
      "de": "Wir müssen heute aufräumen.",
      "daCurrent": "Meil tuleb täna ruum korda teha.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-116",
      "index": 116,
      "batch": "batch-101-150",
      "de": "Ich höre jetzt auf.",
      "daCurrent": "Ma lõpetan nüüd.",
