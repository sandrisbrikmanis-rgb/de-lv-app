      "level": "Sätze"
    },
    {
      "cardId": "sentence-119",
      "index": 119,
      "batch": "batch-101-150",
      "de": "Sie hat mich aufgeregt.",
      "daCurrent": "Ta ärritas mind.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-120",
      "index": 120,
      "batch": "batch-101-150",
      "de": "Auf einmal.",
      "daCurrent": "Järsku.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-121",
      "index": 121,
