    },
    {
      "cardId": "sentence-103",
      "index": 103,
      "batch": "batch-101-150",
      "de": "Bis ans Ende.",
      "daCurrent": "Lõpuni.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-104",
      "index": 104,
      "batch": "batch-101-150",
      "de": "Du glaubst mir anscheinend nicht.",
      "daCurrent": "Näib, et sa ei usu mind.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-105",
      "index": 105,
      "batch": "batch-101-150",
      "de": "Meiner Ansicht nach...",
      "daCurrent": "Minu arvates...",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-106",
      "index": 106,
      "batch": "batch-101-150",
      "de": "Stell dich nicht so an!",
      "daCurrent": "Ära teeskle!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-107",
      "index": 107,
      "batch": "batch-101-150",
      "de": "An die Arbeit gehen.",
