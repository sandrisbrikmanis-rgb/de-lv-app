{
  "batch": "batch-351-400",
  "startIndex": 350,
  "endIndex": 399,
  "count": 50,
  "sentences": [
    {
      "cardId": "sentence-350",
      "index": 350,
      "batch": "batch-351-400",
      "de": "So ist es üblich.",
      "daCurrent": "Nii on kombeks.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-351",
      "index": 351,
      "batch": "batch-351-400",
      "de": "Deine Uhr geht nach.",
      "daCurrent": "Sinu kell jääb maha.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-352",
      "index": 352,
      "batch": "batch-351-400",
      "de": "Wie viel Uhr ist es?",
      "daCurrent": "Mis kell on?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-353",
      "index": 353,
      "batch": "batch-351-400",
      "de": "Um acht Uhr früh.",
      "daCurrent": "Kell kaheksa hommikul.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-354",
      "index": 354,
      "batch": "batch-351-400",
      "de": "umso mehr",
      "daCurrent": "seda enam",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-355",
      "index": 355,
      "batch": "batch-351-400",
      "de": "Rechts um!",
      "daCurrent": "Pöörduge paremale!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-356",
      "index": 356,
      "batch": "batch-351-400",
      "de": "Und ob!",
      "daCurrent": "Ja veel kuidas!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-357",
      "index": 357,
      "batch": "batch-351-400",
      "de": "und zwar",
      "daCurrent": "nimelt",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-358",
      "index": 358,
      "batch": "batch-351-400",
      "de": "Auf Unkosten von...",
      "daCurrent": "... arvel.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-359",
      "index": 359,
      "batch": "batch-351-400",
      "de": "Er saß unter den Zuschauern.",
      "daCurrent": "Ta istus pealtvaatajate hulgas.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-360",
      "index": 360,
      "batch": "batch-351-400",
      "de": "Keine Ursache!",
      "daCurrent": "Pole tänu väärt!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-361",
      "index": 361,
      "batch": "batch-351-400",
      "de": "Es geschah, wie verabredet.",
      "daCurrent": "Läks nii, nagu oli kokku lepitud.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-362",
      "index": 362,
      "batch": "batch-351-400",
      "de": "Rauchen verboten!",
      "daCurrent": "Suitsetamine keelatud!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-363",
      "index": 363,
      "batch": "batch-351-400",
      "de": "Falsch verbunden!",
      "daCurrent": "Vale ühendus!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-364",
      "index": 364,
      "batch": "batch-351-400",
      "de": "Eintritt verboten!",
      "daCurrent": "Sissepääs keelatud!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-365",
      "index": 365,
      "batch": "batch-351-400",
      "de": "Verstehen Sie mich?",
      "daCurrent": "Kas te saate minust aru?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-366",
      "index": 366,
      "batch": "batch-351-400",
      "de": "Er versteht nichts davon.",
      "daCurrent": "Ta ei saa sellest midagi aru.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-367",
      "index": 367,
      "batch": "batch-351-400",
      "de": "Seine Ansicht vertreten.",
      "daCurrent": "Kaitsta oma seisukohta.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-368",
      "index": 368,
      "batch": "batch-351-400",
      "de": "Streit verursachen.",
      "daCurrent": "Põhjustada tüli.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-369",
      "index": 369,
      "batch": "batch-351-400",
      "de": "Viel besser.",
      "daCurrent": "Palju parem.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-370",
      "index": 370,
      "batch": "batch-351-400",
      "de": "Zu viel.",
      "daCurrent": "Liiga palju.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-371",
      "index": 371,
      "batch": "batch-351-400",
      "de": "Vom Hörensagen.",
      "daCurrent": "Kuulduste järgi.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-372",
      "index": 372,
      "batch": "batch-351-400",
      "de": "Von Zeit zu Zeit.",
      "daCurrent": "Aeg-ajalt.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-373",
      "index": 373,
      "batch": "batch-351-400",
      "de": "Von Beruf.",
      "daCurrent": "Elukutse poolest.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-374",
      "index": 374,
      "batch": "batch-351-400",
      "de": "Er ist Berliner von Geburt.",
      "daCurrent": "Ta on sündinud berliinlane.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-375",
      "index": 375,
      "batch": "batch-351-400",
      "de": "Er steht vor dem Fenster.",
      "daCurrent": "Ta seisab akna ees.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-376",
      "index": 376,
      "batch": "batch-351-400",
      "de": "Vor Sonnenaufgang.",
      "daCurrent": "Enne päikesetõusu.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-377",
      "index": 377,
      "batch": "batch-351-400",
      "de": "Vor vierzehn Tagen.",
      "daCurrent": "Kaks nädalat tagasi.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-378",
      "index": 378,
      "batch": "batch-351-400",
      "de": "Vor Freude.",
      "daCurrent": "Rõõmu pärast.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-379",
      "index": 379,
      "batch": "batch-351-400",
      "de": "Vor allem.",
      "daCurrent": "Esiteks. • Kõigepealt.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-380",
      "index": 380,
      "batch": "batch-351-400",
      "de": "Im Voraus.",
      "daCurrent": "Ette. • Eelnevalt.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-381",
      "index": 381,
      "batch": "batch-351-400",
      "de": "Unter der Voraussetzung, dass...",
      "daCurrent": "Eeldusel, et...",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-382",
      "index": 382,
      "batch": "batch-351-400",
      "de": "Unter dem Vorbehalt.",
      "daCurrent": "Tingimusel.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-383",
      "index": 383,
      "batch": "batch-351-400",
      "de": "Vorhanden sein.",
      "daCurrent": "Olemas olla. • Kohal olla. • Kättesaadav olla.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-384",
      "index": 384,
      "batch": "batch-351-400",
      "de": "In der vorigen Woche.",
      "daCurrent": "Eelmisel nädalal.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-385",
      "index": 385,
      "batch": "batch-351-400",
      "de": "Vorkehrungen treffen.",
      "daCurrent": "Võtta ette kaitsemeetmed.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-386",
      "index": 386,
      "batch": "batch-351-400",
      "de": "Sie kommt mir bekannt vor.",
      "daCurrent": "Ta tundub mulle tuttav.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-387",
      "index": 387,
      "batch": "batch-351-400",
      "de": "Er hat Vorliebe für Literatur.",
      "daCurrent": "Talle meeldib väga kirjandus.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-388",
      "index": 388,
      "batch": "batch-351-400",
      "de": "Heute Vormittag.",
      "daCurrent": "Täna hommikul. • Täna enne lõunat.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-389",
      "index": 389,
      "batch": "batch-351-400",
      "de": "Von vorn.",
      "daCurrent": "Eest.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-390",
      "index": 390,
      "batch": "batch-351-400",
      "de": "Nach vorn.",
      "daCurrent": "Edasi.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-391",
      "index": 391,
      "batch": "batch-351-400",
      "de": "Von vornherein.",
      "daCurrent": "Algusest peale.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-392",
      "index": 392,
      "batch": "batch-351-400",
      "de": "Im Vorteil sein.",
      "daCurrent": "Olla soodsamas seisus.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-393",
      "index": 393,
      "batch": "batch-351-400",
      "de": "Wach sein.",
      "daCurrent": "Olla ärkvel.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-394",
      "index": 394,
      "batch": "batch-351-400",
      "de": "Wach werden.",
      "daCurrent": "Ärgata.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-395",
      "index": 395,
      "batch": "batch-351-400",
      "de": "Auf Wache sein.",
      "daCurrent": "Seista valves.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-396",
      "index": 396,
      "batch": "batch-351-400",
      "de": "Während eines Jahres.",
      "daCurrent": "Aasta jooksul.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-397",
      "index": 397,
      "batch": "batch-351-400",
      "de": "Während des Krieges.",
      "daCurrent": "Sõja ajal.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-398",
      "index": 398,
      "batch": "batch-351-400",
      "de": "Gegen eine Wand reden.",
      "daCurrent": "Rääkida asjatult.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-399",
      "index": 399,
      "batch": "batch-351-400",
      "de": "Hier haben die Wände Ohren.",
      "daCurrent": "Siin on seintel kõrvad.",
      "level": "Sätze"
    }
  ]
}