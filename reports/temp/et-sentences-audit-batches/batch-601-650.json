      "level": "Sätze"
    },
    {
      "cardId": "sentence-607",
      "index": 607,
      "batch": "batch-601-650",
      "de": "Muss ich in Koblenz umsteigen?",
      "daCurrent": "Kas ma pean Koblenzis ümber istuma?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-608",
      "index": 608,
      "batch": "batch-601-650",
      "de": "Ja, dort musst du umsteigen.",
      "daCurrent": "Jah, seal pead sa ümber istuma.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-609",
      "index": 609,
      "batch": "batch-601-650",
      "de": "Ist dieser Platz frei?",
      "daCurrent": "Kas see koht on vaba?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-610",
      "index": 610,
      "batch": "batch-601-650",
      "de": "Nein, hier sitzt niemand.",
      "daCurrent": "Ei, siin ei istu keegi.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-611",
      "index": 611,
      "batch": "batch-601-650",
      "de": "Wo ist der Bahnsteigkartenautomat?",
      "daCurrent": "Kus on perroonipiletite automaat?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-612",
      "index": 612,
      "batch": "batch-601-650",
      "de": "Stell mein Handgepäck ins Gepäcknetz.",
      "daCurrent": "Pane mu käsipagas võrele.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-613",
      "index": 613,
      "batch": "batch-601-650",
      "de": "Kann ich das Fenster aufmachen?",
      "daCurrent": "Kas ma tohin akna avada?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-614",
      "index": 614,
      "batch": "batch-601-650",
      "de": "Es zieht, schließ bitte das Fenster!",
      "daCurrent": "Tõmbab tuult, sulge palun aken!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-615",
      "index": 615,
      "batch": "batch-601-650",
      "de": "Welche ist die nächste Station?",
