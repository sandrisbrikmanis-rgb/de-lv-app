      "level": "Sätze"
    },
    {
      "cardId": "sentence-636",
      "index": 636,
      "batch": "batch-601-650",
      "de": "Kellner, die Speisekarte, bitte!",
      "daCurrent": "Ettekandja, menüü, palun!",
