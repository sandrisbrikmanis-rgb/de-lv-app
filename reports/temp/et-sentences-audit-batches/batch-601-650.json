      "level": "Sätze"
    },
    {
      "cardId": "sentence-639",
      "index": 639,
      "batch": "batch-601-650",
      "de": "Kellner, zahlen bitte!",
      "daCurrent": "Ettekandja, palun arve!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-640",
      "index": 640,
      "batch": "batch-601-650",
      "de": "Ich gehe ins Café einen Kaffee trinken.",
