    },
    {
      "cardId": "sentence-627",
      "index": 627,
      "batch": "batch-601-650",
      "de": "Morgen reise ich ab. Weck mich um sieben Uhr!",
      "daCurrent": "Homme sõidan ära. Ärata mind kell seitse!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-628",
      "index": 628,
      "batch": "batch-601-650",
      "de": "Die Rechnung, bitte!",
      "daCurrent": "Arve, palun!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-629",
      "index": 629,
      "batch": "batch-601-650",
      "de": "Wo ist die Stadtbibliothek?",
      "daCurrent": "Kus on linnaraamatukogu?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-630",
      "index": 630,
      "batch": "batch-601-650",
      "de": "Wann hat das Museum geöffnet?",
