    },
    {
      "cardId": "sentence-645",
      "index": 645,
      "batch": "batch-601-650",
      "de": "Haben Sie etwas Erfrischendes?",
      "daCurrent": "Kas teil on midagi karastavat?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-646",
      "index": 646,
      "batch": "batch-601-650",
      "de": "Eine Portion Eis, bitte!",
