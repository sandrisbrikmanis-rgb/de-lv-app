  "sentences": [
    {
      "cardId": "sentence-600",
      "index": 600,
      "batch": "batch-601-650",
      "de": "Hol mir bitte ein Taxi, ich verpasse sonst den Zug!",
      "daCurrent": "Kutsu palun takso, muidu jään rongist maha!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-601",
      "index": 601,
      "batch": "batch-601-650",
      "de": "Fahr bitte zum Bahnhof!",
      "daCurrent": "Vii palun jaama!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-602",
      "index": 602,
      "batch": "batch-601-650",
      "de": "Ich muss mich beeilen.",
      "daCurrent": "Ma pean kiirustama.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-603",
      "index": 603,
      "batch": "batch-601-650",
      "de": "Ist der Schalter schon offen?",
      "daCurrent": "Kas kassa on juba avatud?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-604",
      "index": 604,
      "batch": "batch-601-650",
      "de": "Eine Fahrkarte nach Köln, bitte.",
      "daCurrent": "Üks pilet Kölnini, palun.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-605",
      "index": 605,
      "batch": "batch-601-650",
      "de": "Wann fährt der Zug ab?",
