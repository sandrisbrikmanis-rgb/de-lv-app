      "level": "Sätze"
    },
    {
      "cardId": "sentence-616",
      "index": 616,
      "batch": "batch-601-650",
      "de": "Wie lange hält der Zug?",
      "daCurrent": "Kui kaua rong seisab?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-617",
      "index": 617,
      "batch": "batch-601-650",
      "de": "Wo muss ich umsteigen?",
      "daCurrent": "Kus ma pean ümber istuma?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-618",
      "index": 618,
      "batch": "batch-601-650",
      "de": "Der Zug hat Verspätung.",
      "daCurrent": "Rong hilineb.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-619",
      "index": 619,
      "batch": "batch-601-650",
      "de": "Dieser Wagen ist für Nichtraucher.",
      "daCurrent": "See vagun on mittesuitsetajatele.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-620",
      "index": 620,
      "batch": "batch-601-650",
      "de": "Wir fahren jetzt über die Grenze.",
      "daCurrent": "Nüüd sõidame üle piiri.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-621",
      "index": 621,
      "batch": "batch-601-650",
      "de": "Hast du etwas zu verzollen?",
      "daCurrent": "Kas sul on midagi tollile deklareerida?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-622",
      "index": 622,
      "batch": "batch-601-650",
      "de": "Wir sind in Berlin angekommen.",
      "daCurrent": "Oleme jõudnud Berliini.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-623",
      "index": 623,
      "batch": "batch-601-650",
      "de": "Kannst du mir ein gutes Hotel empfehlen?",
