  {
    "cardId": "b1-anbauen",
    "field": "study.explanation",
    "verdict": "FIX",
    "correctedText": "Glavna ideja: anbauen najčešće znači uzgajati biljke ili nešto dograditi uz zgradu. Značenje određuje objekat: Gemüse ili Tomaten se uzgajaju, a Garage ili Zimmer se dograđuju.",
    "shortReason": "„Dograditi zgradi“ nije gramatički ni semantički ispravno.",
    "severity": null,
    "issueType": "explanation",
    "batchKey": "explanation-0",
    "auditedAt": "2026-08-08T09:35:23.765Z"
  },
  {
    "cardId": "b1-gewiss",
    "field": "study.explanation",
    "verdict": "FIX",
    "correctedText": "Glavna ideja: gewiss znači siguran, određen ili „sigurno“. Zvuči malo formalnije nego sicher i često se pojavljuje u frazama poput ein gewisses Risiko.",
    "shortReason": "Ponavlja se „siguran“ i nedostaje značenje „određen“.",
    "severity": null,
    "issueType": "explanation",
    "batchKey": "explanation-0",
    "auditedAt": "2026-08-08T09:35:23.765Z"
  },
  {
    "cardId": "b1-holen",
    "field": "study.explanation",
    "verdict": "FIX",
    "correctedText": "Glavna ideja: holen znači otići ili odvesti se po nešto i zatim to donijeti ili dovesti. Često se koristi i za osobe: jemanden abholen.",
    "shortReason": "„Odvesti po nešto“ pogrešno znači odvesti nekoga.",
    "severity": null,
    "issueType": "explanation",
    "batchKey": "explanation-0",
    "auditedAt": "2026-08-08T09:35:23.765Z"
  },
  {
    "cardId": "b1-schlag",
    "field": "study.explanation",
    "verdict": "FIX",
    "correctedText": "Glavna ideja: der Schlag znači udarac ili udar. U kontekstu, to može biti i udar groma, udarac sata ili vrsta.",
    "shortReason": "„Udarac ili udarac“ nepotrebno ponavlja istu riječ.",
    "severity": null,
    "issueType": "explanation",
    "batchKey": "explanation-0",
    "auditedAt": "2026-08-08T09:35:23.765Z"
  },
  {
    "cardId": "b1-übernehmen",
    "field": "study.explanation",
    "verdict": "FIX",
    "correctedText": "Glavna ideja: übernehmen znači preuzeti posao, dužnost ili odgovornost. Kada se koristi s riječju Kosten, to znači snositi troškove.",
    "shortReason": "„Kod Kostena“ je neprirodan i gramatički neispravan izraz.",
    "severity": null,
    "issueType": "explanation",
    "batchKey": "explanation-0",
    "auditedAt": "2026-08-08T09:35:23.765Z"
  },
  {
    "cardId": "b1-verhältnis",
    "field": "study.explanation",
    "verdict": "FIX",
    "correctedText": "Glavna ideja: das Verhältnis znači odnos, proporciju ili međusobni omjer. Verhältnisse u množini često znače okolnosti ili uslove.",
    "shortReason": "Glagol uz množinu „Verhältnisse“ treba biti „znače“.",
    "severity": null,
    "issueType": "explanation",
    "batchKey": "explanation-0",
    "auditedAt": "2026-08-08T09:35:23.765Z"
  },
  {
    "cardId": "b1-verletzen",
    "field": "study.explanation",
    "verdict": "FIX",
    "correctedText": "Glavna ideja: verletzen znači fizički povrijediti ili povrijediti nečije osjećaje. Također se koristi za kršenje pravila.",
    "shortReason": "Ponavljanje ne razlikuje fizičku povredu i povredu osjećaja.",
    "severity": null,
    "issueType": "explanation",
    "batchKey": "explanation-0",
    "auditedAt": "2026-08-08T09:35:23.765Z"
  },
