    {
      "auditId": "ET-SENT-0071",
      "cardId": "sentence-315",
      "field": "lv",
      "current": "Milleks see kõik?",
      "ownerNew": "Mis kasu sellest kõigest on?"
    },
    {
      "auditId": "ET-SENT-0075",
      "cardId": "sentence-324",
      "field": "lv",
      "current": "On juba hea!",
