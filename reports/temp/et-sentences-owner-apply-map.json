    {
      "auditId": "ET-SENT-0111",
      "cardId": "sentence-559",
      "field": "lv",
      "current": "Äikesetorm on möödas.",
      "ownerNew": "Äikesetorm läheb üle."
    },
    {
      "auditId": "ET-SENT-0112",
      "cardId": "sentence-562",
      "field": "lv",
      "current": "Talv on käes, öösel sadas lund.",
