    {
      "auditId": "ET-SENT-0096",
      "cardId": "sentence-446",
      "field": "lv",
      "current": "Vorsti otsatükk.",
      "ownerNew": "Vorstiots."
    },
    {
      "auditId": "ET-SENT-0102",
      "cardId": "sentence-503",
      "field": "lv",
      "current": "Tõuse üles, Hanna, kella helistatakse!",
      "ownerNew": "Tõuse üles, Hanna, kell heliseb!"
