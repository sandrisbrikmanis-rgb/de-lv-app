    {
      "auditId": "ET-SENT-0110",
      "cardId": "sentence-545",
      "field": "lv",
      "current": "Kui ma tööl tulen, olen alati väsinud.",
      "ownerNew": "Kui ma töölt tulen, olen alati väsinud."
