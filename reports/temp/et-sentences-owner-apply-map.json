    {
      "auditId": "ET-SENT-0062",
      "cardId": "sentence-274",
      "field": "lv",
      "current": "Kas ma saaksin rääkida proua N-ga?",
      "ownerNew": "Kas ma saaksin rääkida proua N-iga?"
    },
    {
      "auditId": "ET-SENT-0064",
      "cardId": "sentence-284",
      "field": "lv",
      "current": "Mis on juhtunud?",
