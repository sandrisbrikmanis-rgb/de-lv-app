    {
      "auditId": "ET-SENT-0120",
      "cardId": "sentence-601",
      "field": "lv",
      "current": "Vii palun jaama!",
      "ownerNew": "Sõida palun jaama!"
    },
    {
      "auditId": "ET-SENT-0121",
      "cardId": "sentence-604",
      "field": "lv",
      "current": "Üks pilet Kölnini, palun.",
      "ownerNew": "Üks pilet Kölni, palun."
    },
    {
      "auditId": "ET-SENT-0123",
      "cardId": "sentence-612",
      "field": "lv",
      "current": "Pane mu käsipagas võrele.",
      "ownerNew": "Pane mu käsipagas pagasivõrku."
