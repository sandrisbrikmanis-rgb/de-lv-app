      "cardId": "sentence-242",
      "field": "lv",
      "current": "lapsepõlvest saati • algusest peale",
      "ownerNew": "loomu poolest"
    },
    {
      "auditId": "ET-SENT-0055",
      "cardId": "sentence-246",
      "field": "lv",
      "current": "Mis sul viga on? • Mis on juhtunud?",
