    {
      "auditId": "ET-SENT-0116",
      "cardId": "sentence-582",
      "field": "lv",
      "current": "Olen siin esimest korda.",
      "ownerNew": "Olen selles piirkonnas esimest korda."
    },
    {
      "auditId": "ET-SENT-0117",
      "cardId": "sentence-589",
      "field": "lv",
      "current": "Kuidas kiiremini jaama jõuda?",
      "ownerNew": "Kuidas ma kõige kiiremini jaama jõuan?"
    },
    {
      "auditId": "ET-SENT-0118",
      "cardId": "sentence-592",
      "field": "lv",
      "current": "Kas sa sõidad töö pärast või puhkusele?",
