    {
      "auditId": "ET-SENT-0124",
      "cardId": "sentence-625",
      "field": "lv",
      "current": "Kaheinimesetuba, palun.",
      "ownerNew": "Tuba kahe voodiga, palun."
    },
    {
      "auditId": "ET-SENT-0126",
      "cardId": "sentence-651",
      "field": "lv",
      "current": "Tuleta mulle homme meelde kirja kirjutada!",
      "ownerNew": "Tuleta mulle homme meelde, et ma kirjutaksin!"
    },
    {
      "auditId": "ET-SENT-0127",
      "cardId": "sentence-652",
      "field": "lv",
      "current": "Palun pane see kiri postkasti!",
      "ownerNew": "Palun pange see kiri postkasti!"
    },
    {
      "auditId": "ET-SENT-0129",
      "cardId": "sentence-657",
      "field": "lv",
      "current": "Taga, palun, mitte liiga lühikeseks.",
      "ownerNew": "Tagant palun mitte liiga lühikeseks."
    },
    {
      "auditId": "ET-SENT-0130",
      "cardId": "sentence-659",
      "field": "lv",
      "current": "Algab pool kaheksa.",
      "ownerNew": "See algab kell pool kaheksa."
    },
    {
      "auditId": "ET-SENT-0131",
      "cardId": "sentence-660",
      "field": "lv",
      "current": "Kõik piletid on välja müüdud.",
      "ownerNew": "Kõik kohad on välja müüdud."
    },
    {
      "auditId": "ET-SENT-0132",
      "cardId": "sentence-665",
      "field": "lv",
      "current": "Kas ma tohin tantsule kutsuda?",
      "ownerNew": "Kas ma tohin sind tantsule kutsuda?"
    },
    {
      "auditId": "ET-SENT-0133",
      "cardId": "sentence-673",
      "field": "lv",
      "current": "Kas kõik on juba kastidesse pandud?",
      "ownerNew": "Kas oled kõik juba sisse pakkinud?"
    },
    {
      "auditId": "ET-SENT-0134",
      "cardId": "sentence-674",
      "field": "lv",
      "current": "Olen kirjavahetuses oma sõbraga.",
      "ownerNew": "Olen oma sõbraga kontaktis."
    },
    {
      "auditId": "ET-SENT-0136",
      "cardId": "sentence-686",
      "field": "lv",
      "current": "Ta on ikkagi üsna muutunud.",
      "ownerNew": "Ta on aga üsna palju muutunud."
    },
    {
      "auditId": "ET-SENT-0138",
      "cardId": "sentence-695",
      "field": "lv",
      "current": "Heida voodisse pikali!",
      "ownerNew": "Heida voodisse!"
    },
    {
      "auditId": "ET-SENT-0139",
      "cardId": "sentence-698",
      "field": "lv",
      "current": "Mul valutab hammas.",
      "ownerNew": "Mul valutavad hambad."
    },
    {
      "auditId": "ET-SENT-0140",
      "cardId": "sentence-702",
      "field": "lv",
      "current": "Tahan korterit uuesti sisustada.",
      "ownerNew": "Tahan oma korterit uuesti sisustada."
    },
    {
      "auditId": "ET-SENT-0141",
      "cardId": "sentence-711",
      "field": "lv",
      "current": "Juba aasta võtan saksa keele tunde.",
      "ownerNew": "Olen juba aasta aega saksa keele tunde võtnud."
    },
    {
      "auditId": "ET-SENT-0142",
      "cardId": "sentence-714",
      "field": "lv",
      "current": "Kahjuks on raamat läbi müüdud.",
      "ownerNew": "Kahjuks on raamat välja müüdud."
    },
    {
      "auditId": "ET-SENT-0143",
      "cardId": "sentence-723",
      "field": "lv",
      "current": "Kaaluge palun kaks kilogrammi.",
      "ownerNew": "Kaaluge mulle palun kaks kilogrammi."
    },
    {
      "auditId": "ET-SENT-0144",
      "cardId": "sentence-726",
      "field": "lv",
      "current": "Andke kaks kilogrammi hakkliha.",
      "ownerNew": "Andke mulle kaks kilogrammi hakkliha."
    },
    {
      "auditId": "ET-SENT-0146",
      "cardId": "sentence-727",
      "field": "lv",
      "current": "Üks leivapäts, palun, aga mitte liiga kõva.",
      "ownerNew": "Üks leivapäts, palun, aga mitte liiga krõbe."
    },
    {
      "auditId": "ET-SENT-0147",
      "cardId": "sentence-735",
      "field": "lv",
      "current": "Andke palun kilogramm riisi.",
      "ownerNew": "Andke mulle palun kilogramm riisi."
    },
    {
      "auditId": "ET-SENT-0149",
      "cardId": "sentence-738",
      "field": "lv",
      "current": "Kas te saate mööbli korterisse toimetada?",
      "ownerNew": "Kas te saate mööbli minu korterisse toimetada?"
    },
    {
      "auditId": "ET-SENT-0150",
      "cardId": "sentence-743",
      "field": "lv",
      "current": "Lõigake palun kolm meetrit.",
      "ownerNew": "Lõigake mulle palun kolm meetrit."
    },
    {
      "auditId": "ET-SENT-0151",
      "cardId": "sentence-744",
      "field": "lv",
      "current": "Kas teil on ka teisi näidiseid?",
      "ownerNew": "Kas teil on ka teisi mustreid?"
    },
    {
      "auditId": "ET-SENT-0153",
      "cardId": "sentence-746",
      "field": "lv",
      "current": "Andke heledam.",
      "ownerNew": "Andke mulle heledam."
    },
    {
      "auditId": "ET-SENT-0154",
      "cardId": "sentence-750",
      "field": "lv",
      "current": "Nii, nüüd sobib hästi.",
      "ownerNew": "Nii, nüüd sobivad need hästi."
    },
    {
      "auditId": "ET-SENT-0155",
      "cardId": "sentence-753",
      "field": "lv",
      "current": "Millal on valmis?",
      "ownerNew": "Millal ta valmis saab?"
    },
    {
      "auditId": "ET-SENT-0156",
      "cardId": "sentence-757",
      "field": "lv",
      "current": "Millal kleit on valmis?",
      "ownerNew": "Millal kleit valmis saab?"
    },
    {
      "auditId": "ET-SENT-0157",
