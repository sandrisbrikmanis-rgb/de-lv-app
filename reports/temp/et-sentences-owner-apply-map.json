    {
      "auditId": "ET-SENT-0107",
      "cardId": "sentence-534",
      "field": "lv",
      "current": "Aitäh, mul on juba.",
      "ownerNew": "Aitäh, mul juba on."
    },
    {
      "auditId": "ET-SENT-0108",
      "cardId": "sentence-536",
      "field": "lv",
      "current": "Aitäh, ma olen juba söönud.",
      "ownerNew": "Aitäh, kõht on juba täis."
    },
    {
      "auditId": "ET-SENT-0109",
      "cardId": "sentence-541",
      "field": "lv",
      "current": "Palun söö, kui palju tahad!",
