    { "cardId": "c1-wahl", "fieldPath": "study.explanation", "before": "Die Wahl can mean a choice between options. In the context of politics, Wahl means election. It can also mean voting itself. The phrase eine Wahl treffen means to make a choice. zur Wahl gehen means to go to the polls. The context of a policy or personal decision shows the correct meaning.", "after": "Die Wahl can mean a choice between options. In the context of politics, Wahl means an election. It can also mean voting itself. The phrase eine Wahl treffen means to make a choice. zur Wahl gehen means to go to the polls. The context of politics or a personal decision shows the correct meaning." },
    { "cardId": "c1-wahl", "fieldPath": "study.examples[1].lv", "before": "I make my choice tomorrow.", "after": "I will make my choice tomorrow." },
    { "cardId": "c1-gelegentlich", "fieldPath": "study.translation", "before": "Sometimes • Occasion • Due to", "after": "Sometimes • Occasional • On the occasion of" },
    { "cardId": "c1-gelegentlich", "fieldPath": "study.explanation", "before": "Main idea: gelegentlich is a word with three functions. Adjective: casual (ein gelegentlicher Besuch). Adverb: sometimes, from time to time (Er kommt gelegentlich). Preposition + dative: due to (gelegentlich des Festes).", "after": "Main idea: gelegentlich has three functions. Adjective: occasional (ein gelegentlicher Besuch). Adverb: sometimes, from time to time (Er kommt gelegentlich). Preposition + genitive: on the occasion of (gelegentlich des Festes)." },
    { "cardId": "c1-gelegentlich", "fieldPath": "study.comparison[1].meaning", "before": "Casual • Accidental", "after": "Occasional • Incidental" },
    { "cardId": "c1-gelegentlich", "fieldPath": "study.comparison[2].meaning", "before": "Due to", "after": "On the occasion of" },
    { "cardId": "c1-gelegentlich", "fieldPath": "study.important.text", "before": "Adj.: casual. Adv.: sometimes. Prep. + Gen.: due to. Context determines meaning.", "after": "Adj.: occasional. Adv.: sometimes. Prep. + Gen.: on the occasion of. Context determines meaning." },
    { "cardId": "c1-wahlberechtigt", "fieldPath": "study.translation", "before": "One who has the right to vote", "after": "Eligible to vote" },
    { "cardId": "c1-wahlberechtigt", "fieldPath": "study.explanation", "before": "Main idea: wahlberechtig is an adjective that means a person has the right to participate in an election—to vote or stand for election. Compound: Wahl (election) + behrechtig (entitled).", "after": "Main idea: wahlberechtigt is an adjective meaning that a person is entitled to vote in an election. Compound: Wahl (election) + berechtigt (entitled)." },
    { "cardId": "c1-wahlberechtigt", "fieldPath": "study.examples[1].lv", "before": "From the age of 18 have the right to vote.", "after": "From the age of 18, people have the right to vote." },
    { "cardId": "c1-wahlberechtigt", "fieldPath": "study.comparison[0].meaning", "before": "With the right to vote", "after": "Eligible to vote" },
    { "cardId": "c1-wahlberechtigt", "fieldPath": "study.comparison[1].meaning", "before": "To wish • To vote", "after": "To choose • To vote" },
    { "cardId": "c1-wahlberechtigt", "fieldPath": "study.tip.leftBlocks[0].text", "before": "Wahl = election, behrechtig = eligible. Common in press and legal texts.", "after": "Wahl = election, berechtigt = entitled. Common in press and legal texts." },
    { "cardId": "c1-wahlberechtigt", "fieldPath": "study.important.text", "before": "wahlberechtig = with the right to vote. Opposite: nicht wahlberechtigkeit.", "after": "wahlberechtigt = eligible to vote. Opposite: nicht wahlberechtigt." },
