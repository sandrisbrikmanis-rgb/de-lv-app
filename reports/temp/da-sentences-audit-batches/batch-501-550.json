{
  "batch": "batch-501-550",
  "startIndex": 500,
  "endIndex": 549,
  "count": 50,
  "sentences": [
    {
      "cardId": "sentence-500",
      "index": 500,
      "batch": "batch-501-550",
      "de": "Es ist halb acht.",
      "daCurrent": "Klokken er halv otte.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-501",
      "index": 501,
      "batch": "batch-501-550",
      "de": "Wann wachst du gewöhnlich auf?",
      "daCurrent": "Hvornår plejer du at vågne?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-502",
      "index": 502,
      "batch": "batch-501-550",
      "de": "Ich stehe gleich auf.",
      "daCurrent": "Jeg rejser mig med det samme.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-503",
      "index": 503,
      "batch": "batch-501-550",
      "de": "Steh auf, Hanna, es klingelt!",
      "daCurrent": "Rejs dig op, Hannah, klokken ringer!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-504",
      "index": 504,
      "batch": "batch-501-550",
      "de": "Lass mich noch fünf Minuten schlafen!",
      "daCurrent": "Lad mig sove i fem minutter mere!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-505",
      "index": 505,
      "batch": "batch-501-550",
      "de": "Vergiss nicht, das Zimmer zu lüften!",
      "daCurrent": "Glem ikke at ventilere rummet!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-506",
      "index": 506,
      "batch": "batch-501-550",
      "de": "Wo ist das Handtuch?",
      "daCurrent": "Hvor er håndklædet",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-507",
      "index": 507,
      "batch": "batch-501-550",
      "de": "Ich möchte mir die Zähne putzen.",
      "daCurrent": "Jeg vil gerne børste mine tænder.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-508",
      "index": 508,
      "batch": "batch-501-550",
      "de": "Mit was putzt du dir die Zähne?",
      "daCurrent": "Hvad børster du tænder med?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-509",
      "index": 509,
      "batch": "batch-501-550",
      "de": "Ich möchte mich anziehen.",
      "daCurrent": "Jeg vil gerne klædes på.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-510",
      "index": 510,
      "batch": "batch-501-550",
      "de": "Zieh dich bitte schnell an!",
      "daCurrent": "Klæd dig hurtigt på, tak!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-511",
      "index": 511,
      "batch": "batch-501-550",
      "de": "Kleide dich wärmer an, draußen ist es kühl.",
      "daCurrent": "Klæd dig varmt på, det er koldt udenfor.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-512",
      "index": 512,
      "batch": "batch-501-550",
      "de": "Guten Morgen, wie geht es dir?",
      "daCurrent": "Godmorgen, hvordan har du det?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-513",
      "index": 513,
      "batch": "batch-501-550",
      "de": "Mir geht es gut, danke.",
      "daCurrent": "Jeg har det godt, tak.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-514",
      "index": 514,
      "batch": "batch-501-550",
      "de": "Was gibt es Neues?",
      "daCurrent": "Hvad er nyt?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-515",
      "index": 515,
      "batch": "batch-501-550",
      "de": "Was für ein Chaos hier!",
      "daCurrent": "Hvilket rod det er her!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-516",
      "index": 516,
      "batch": "batch-501-550",
      "de": "Darf ich beim Aufräumen helfen?",
      "daCurrent": "Må jeg hjælpe med at rydde op?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-517",
      "index": 517,
      "batch": "batch-501-550",
      "de": "Was trinkst du morgens, Kaffee oder Tee?",
      "daCurrent": "Hvad drikker du om morgenen, kaffe eller te?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-518",
      "index": 518,
      "batch": "batch-501-550",
      "de": "Gewöhnlich trinke ich morgens eine Tasse Kaffee.",
      "daCurrent": "Jeg plejer at drikke en kop kaffe om morgenen.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-519",
      "index": 519,
      "batch": "batch-501-550",
      "de": "Am liebsten trinke ich schwarzen Kaffee.",
      "daCurrent": "Jeg drikker bedst sort kaffe.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-520",
      "index": 520,
      "batch": "batch-501-550",
      "de": "Guten Morgen, hast du gut geschlafen?",
      "daCurrent": "Godmorgen, sov du godt?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-521",
      "index": 521,
      "batch": "batch-501-550",
      "de": "Ich bin noch sehr müde.",
      "daCurrent": "Jeg er stadig meget træt.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-522",
      "index": 522,
      "batch": "batch-501-550",
      "de": "Willst du Kaffee oder Milch?",
      "daCurrent": "Vil du have kaffe eller mælk?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-523",
      "index": 523,
      "batch": "batch-501-550",
      "de": "Gib mir bitte ein Brötchen mit Käse.",
      "daCurrent": "Giv mig en ostebolle, tak.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-524",
      "index": 524,
      "batch": "batch-501-550",
      "de": "Ich muss jetzt los!",
      "daCurrent": "Jeg er nødt til at gå nu!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-525",
      "index": 525,
      "batch": "batch-501-550",
      "de": "Vergiss dein Frühstück nicht!",
      "daCurrent": "Glem ikke morgenmad!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-526",
      "index": 526,
      "batch": "batch-501-550",
      "de": "Klara, deck bitte den Tisch!",
      "daCurrent": "Clara, vær venlig at dække bordet!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-527",
      "index": 527,
      "batch": "batch-501-550",
      "de": "Vergiss die Servietten nicht!",
      "daCurrent": "Glem ikke servietterne!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-528",
      "index": 528,
      "batch": "batch-501-550",
      "de": "Wann esst ihr zu Mittag?",
      "daCurrent": "Hvornår spiser du frokost",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-529",
      "index": 529,
      "batch": "batch-501-550",
      "de": "Es ist Zeit zu essen.",
      "daCurrent": "Det er tid til at spise.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-530",
      "index": 530,
      "batch": "batch-501-550",
      "de": "Was gibt es heute zu Mittag?",
      "daCurrent": "Hvad skal der til frokost i dag?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-531",
      "index": 531,
      "batch": "batch-501-550",
      "de": "Wie schmeckt dir die Suppe?",
      "daCurrent": "Hvordan kan du lide suppen?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-532",
      "index": 532,
      "batch": "batch-501-550",
      "de": "Ehrlich gesagt ist sie etwas zu salzig.",
      "daCurrent": "Helt ærligt, det er en anelse for salt.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-533",
      "index": 533,
      "batch": "batch-501-550",
      "de": "Darf ich dir ein Stück Brot geben?",
      "daCurrent": "Må jeg give dig en skive brød?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-534",
      "index": 534,
      "batch": "batch-501-550",
      "de": "Danke, ich habe schon.",
      "daCurrent": "Tak, det har jeg allerede.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-535",
      "index": 535,
      "batch": "batch-501-550",
      "de": "Das Fleisch schmeckt ausgezeichnet.",
      "daCurrent": "Kødet smager fantastisk.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-536",
      "index": 536,
      "batch": "batch-501-550",
      "de": "Danke, ich bin schon satt.",
      "daCurrent": "Tak, jeg er allerede mæt.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-537",
      "index": 537,
      "batch": "batch-501-550",
      "de": "Heute haben wir Besuch.",
      "daCurrent": "I dag har vi besøg.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-538",
      "index": 538,
      "batch": "batch-501-550",
      "de": "Bist du heute Abend frei?",
      "daCurrent": "Har du fri i aften",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-539",
      "index": 539,
      "batch": "batch-501-550",
      "de": "Komm doch heute zum Mittagessen vorbei!",
      "daCurrent": "Kom og besøg til frokost i dag!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-540",
      "index": 540,
      "batch": "batch-501-550",
      "de": "Setzen wir uns an den Tisch.",
      "daCurrent": "Lad os sætte os ved bordet.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-541",
      "index": 541,
      "batch": "batch-501-550",
      "de": "Bitte, bedien dich!",
      "daCurrent": "Spis så meget som du vil!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-542",
      "index": 542,
      "batch": "batch-501-550",
      "de": "Stört dich das Rauchen?",
      "daCurrent": "Generer rygning dig?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-543",
      "index": 543,
      "batch": "batch-501-550",
      "de": "Danke für die nette Aufnahme!",
      "daCurrent": "Tak for den varme velkomst!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-544",
      "index": 544,
      "batch": "batch-501-550",
      "de": "Wann gehst du ins Bett?",
      "daCurrent": "Hvornår går du i seng",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-545",
      "index": 545,
      "batch": "batch-501-550",
      "de": "Wenn ich von der Arbeit komme, bin ich immer müde.",
      "daCurrent": "Jeg er altid træt, når jeg kommer hjem fra arbejde.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-546",
      "index": 546,
      "batch": "batch-501-550",
      "de": "Es ist Zeit, ins Bett zu gehen.",
      "daCurrent": "Det er tid til at gå i seng.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-547",
      "index": 547,
      "batch": "batch-501-550",
      "de": "Es ist schönes Wetter.",
      "daCurrent": "Det er en dejlig tid.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-548",
      "index": 548,
      "batch": "batch-501-550",
      "de": "Willst du mit mir spazieren gehen?",
      "daCurrent": "Vil du gå med mig?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-549",
      "index": 549,
      "batch": "batch-501-550",
      "de": "Sieh mal, es wird gleich regnen.",
      "daCurrent": "Se, det vil snart regne.",
      "level": "Sätze"
    }
  ]
}