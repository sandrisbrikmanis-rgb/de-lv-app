  "count": 50,
  "sentences": [
    {
      "cardId": "sentence-650",
      "index": 650,
      "batch": "batch-651-700",
      "de": "Wo ist die Post?",
      "daCurrent": "Hvor er posthuset?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-651",
      "index": 651,
      "batch": "batch-651-700",
      "de": "Erinnere mich morgen daran zu schreiben!",
      "daCurrent": "Mind mig om at skrive under i morgen!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-652",
      "index": 652,
      "batch": "batch-651-700",
      "de": "Werfen Sie bitte diesen Brief in den Briefkasten.",
      "daCurrent": "Send venligst dette brev i postkassen!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-653",
      "index": 653,
      "batch": "batch-651-700",
      "de": "Hallo, hier spricht Emma.",
      "daCurrent": "Hej, det er Emma.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-654",
      "index": 654,
      "batch": "batch-651-700",
      "de": "Kann ich dich später anrufen?",
      "daCurrent": "Kan jeg ringe til dig senere",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-655",
      "index": 655,
      "batch": "batch-651-700",
      "de": "Muss ich lange warten?",
      "daCurrent": "Skal jeg vente længe?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-656",
      "index": 656,
      "batch": "batch-651-700",
      "de": "Bitte schneiden Sie mir die Haare.",
      "daCurrent": "Klip venligst mit hår.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-657",
      "index": 657,
      "batch": "batch-651-700",
      "de": "Hinten bitte nicht zu kurz.",
      "daCurrent": "I ryggen, tak, ikke for kort.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-658",
      "index": 658,
      "batch": "batch-651-700",
      "de": "Wann beginnt die Vorstellung?",
      "daCurrent": "Hvornår starter showet?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-659",
      "index": 659,
      "batch": "batch-651-700",
      "de": "Es fängt um halb acht an.",
      "daCurrent": "Det starter klokken halv ni.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-660",
      "index": 660,
      "batch": "batch-651-700",
      "de": "Alle Plätze sind ausverkauft.",
      "daCurrent": "Alle billetter er udsolgt.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-661",
      "index": 661,
      "batch": "batch-651-700",
      "de": "Drei Karten, bitte!",
      "daCurrent": "Tre billetter, tak!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-662",
      "index": 662,
      "batch": "batch-651-700",
      "de": "Wir lassen die Jacken in der Garderobe.",
      "daCurrent": "Lad os lade jakkerne blive i garderoben.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-663",
      "index": 663,
      "batch": "batch-651-700",
      "de": "Bitte schnell, der Vorhang geht gleich auf!",
      "daCurrent": "Hurtigere tak, gardinet er ved at åbne sig!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-664",
      "index": 664,
      "batch": "batch-651-700",
      "de": "Der Vorhang fällt.",
      "daCurrent": "Gardinet falder.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-665",
      "index": 665,
      "batch": "batch-651-700",
      "de": "Darf ich dich zum Tanz bitten?",
      "daCurrent": "Må jeg bede dig om at danse?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-666",
      "index": 666,
      "batch": "batch-651-700",
      "de": "Wann ist eure Hochzeit?",
      "daCurrent": "Hvornår er jeres bryllup?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-667",
      "index": 667,
      "batch": "batch-651-700",
      "de": "Ich suche eine Wohnung.",
      "daCurrent": "Jeg leder efter en lejlighed.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-668",
      "index": 668,
      "batch": "batch-651-700",
      "de": "Ist in diesem Haus eine Wohnung frei?",
      "daCurrent": "Ist der en ledig lejlighed i dette hus?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-669",
      "index": 669,
      "batch": "batch-651-700",
      "de": "Wie viel kostet die Miete?",
      "daCurrent": "Hvor meget er huslejen?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-670",
      "index": 670,
      "batch": "batch-651-700",
      "de": "Die Wohnung hat drei Zimmer und eine Küche.",
      "daCurrent": "Lejligheden har tre værelser og køkken.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-671",
      "index": 671,
      "batch": "batch-651-700",
      "de": "Heute ziehen wir um.",
      "daCurrent": "Vi flytter i dag.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-672",
      "index": 672,
      "batch": "batch-651-700",
      "de": "Mia, pack die Sachen bitte in Kisten!",
      "daCurrent": "Mia, læg tingene i kasser, tak!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-673",
      "index": 673,
      "batch": "batch-651-700",
      "de": "Hast du alles eingepackt?",
      "daCurrent": "Er alt allerede pakket ind?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-674",
      "index": 674,
      "batch": "batch-651-700",
      "de": "Ich stehe mit meinem Freund in Kontakt.",
      "daCurrent": "Jeg er i korrespondance med min ven.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-675",
      "index": 675,
      "batch": "batch-651-700",
      "de": "Gehen wir ins Theater?",
      "daCurrent": "Skal vi gå i teatret?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-676",
      "index": 676,
      "batch": "batch-651-700",
      "de": "Ist alles eingeladen?",
      "daCurrent": "Er alt indlæst?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-677",
      "index": 677,
      "batch": "batch-651-700",
      "de": "Welch schöne Aussicht!",
      "daCurrent": "Hvilken smuk udsigt!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-678",
      "index": 678,
      "batch": "batch-651-700",
      "de": "Nun können wir alles wieder aufräumen.",
      "daCurrent": "Nu kan vi samle det hele igen.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-679",
      "index": 679,
      "batch": "batch-651-700",
      "de": "Wie viele Zimmer habt ihr?",
      "daCurrent": "Hvor mange rum har du?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-680",
      "index": 680,
      "batch": "batch-651-700",
      "de": "Im Sommer fahre ich ans Meer.",
      "daCurrent": "Jeg tager til havet om sommeren.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-681",
      "index": 681,
      "batch": "batch-651-700",
      "de": "Kannst du schwimmen?",
      "daCurrent": "Kan du svømme",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-682",
      "index": 682,
      "batch": "batch-651-700",
      "de": "Schwimm nicht zu weit hinaus!",
      "daCurrent": "Svøm ikke for langt!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-683",
      "index": 683,
      "batch": "batch-651-700",
      "de": "Badest du jeden Tag?",
      "daCurrent": "Svømmer du hver dag?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-684",
      "index": 684,
      "batch": "batch-651-700",
      "de": "Bei schönem Wetter gehe ich angeln.",
      "daCurrent": "Hvis vejret er godt, tager jeg ud og fiske.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-685",
      "index": 685,
      "batch": "batch-651-700",
      "de": "Wie sieht er aus?",
      "daCurrent": "Hvordan ser han ud?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-686",
      "index": 686,
      "batch": "batch-651-700",
      "de": "Er hat sich aber recht verändert.",
      "daCurrent": "Han har dog ændret sig en del.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-687",
      "index": 687,
      "batch": "batch-651-700",
      "de": "Wie ist er als Mensch?",
      "daCurrent": "Hvordan er han som person?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-688",
      "index": 688,
      "batch": "batch-651-700",
      "de": "Er ist immer nett und freundlich.",
      "daCurrent": "Han er altid sød og venlig.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-689",
      "index": 689,
      "batch": "batch-651-700",
      "de": "Ich fühle mich nicht wohl.",
      "daCurrent": "Jeg har det dårligt.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-690",
      "index": 690,
      "batch": "batch-651-700",
      "de": "Ich habe starke Kopfschmerzen.",
      "daCurrent": "Jeg har en voldsom hovedpine.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-691",
      "index": 691,
      "batch": "batch-651-700",
      "de": "Ich habe mich erkältet.",
      "daCurrent": "Jeg er forkølet.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-692",
      "index": 692,
      "batch": "batch-651-700",
      "de": "Ich habe Schnupfen.",
      "daCurrent": "Jeg har en løbende næse.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-693",
      "index": 693,
      "batch": "batch-651-700",
      "de": "Mir ist schwindlig.",
      "daCurrent": "Jeg er svimmel.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-694",
      "index": 694,
      "batch": "batch-651-700",
      "de": "Ich muss zum Arzt gehen.",
      "daCurrent": "Jeg er nødt til at gå til lægen.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-695",
      "index": 695,
      "batch": "batch-651-700",
      "de": "Leg dich ins Bett!",
      "daCurrent": "Læg dig i sengen!",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-696",
      "index": 696,
      "batch": "batch-651-700",
      "de": "Hast du Fieber?",
      "daCurrent": "Har du feber?",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-697",
      "index": 697,
      "batch": "batch-651-700",
      "de": "Gestern hatte ich erhöhte Temperatur.",
      "daCurrent": "Jeg havde høj temperatur i går.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-698",
      "index": 698,
      "batch": "batch-651-700",
      "de": "Ich habe Zahnschmerzen.",
      "daCurrent": "Jeg har tandpine.",
      "level": "Sätze"
    },
    {
      "cardId": "sentence-699",
      "index": 699,
      "batch": "batch-651-700",
      "de": "Ich muss zum Zahnarzt gehen.",
      "daCurrent": "Jeg skal til tandlægen.",
      "level": "Sätze"
    }
  ]
}